\definecolor{blueWGU}{RGB}{0,48,87}
\definecolor{lightBlueWGU}{RGB}{73,134,160}
\hypersetup{colorlinks=true, urlcolor=blueWGU, linkcolor=blue}

\newcommand*\circled[1]{%changes question label appearance. set in doc preamble \question label
  \tikz[baseline=(char.base)]
    \node[
      shape=circle,
      fill=blueWGU,
      inner sep=1.5pt,
      text=white,
      minimum size=1.5em
    ] (char) {#1};
}


\renewcommand*\circled[1]{%changes question label appearance. set in doc preamble \question label
  \tikz[baseline=(char.base)]
    \node[
      shape=rectangle,
      fill=blueWGU,
      inner sep=1.5pt,
      text=white,
      minimum size=1.5em,
      rounded corners = .25em
    ] (char) {#1};
}

\renewcommand{\questionlabel}{\circled{\thequestion}} %%sets question labels to colored circles

